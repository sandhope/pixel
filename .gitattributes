# Auto-detect text files and normalize line endings
* text=auto

# Enforce LF for source files and documentation, regardless of OS
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.bat text eol=lf
*.cmd text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.conf text eol=lf
*.csv text eol=lf
*.lock text eol=lf
*.md5 text eol=lf

# Treat common binary assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.avi binary

# Generated Wails build artifacts should stay binary
/build/** binary
